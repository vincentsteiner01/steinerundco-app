# app.steinerundco.de – Apache-Einstellungen für Plesk
# HTTPS-Weiterleitung und Zertifikat stellt ihr in Plesk ein (siehe README).

Options -Indexes
DirectoryIndex index.html
AddDefaultCharset utf-8

<IfModule mod_headers.c>
  # Seiten und Skripte immer frisch prüfen, damit Updates sofort ankommen
  <FilesMatch "\.(html|js|css)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(woff2|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Hinweis: Auf dem IONOS-Plesk-Server kommen „Header always set“-Zeilen nicht beim Browser an (geprüft 15.10.2026);
  # „Header set“ wirkt. Für statische Seiten reicht „set“.

  # Privates Werkzeug: nicht in Suchmaschinen
  Header set X-Robots-Tag "noindex, nofollow"

  # Sicherheits-Header
  Header set Strict-Transport-Security "max-age=31536000"
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "no-referrer"
  Header set X-Frame-Options "DENY"
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  # Erlaubt nur eigene Dateien, supabase-js von jsDelivr und das Supabase-Projekt.
  # blob: für die Vorschau beim Hochladen, data: für das Pfeil-Symbol in Auswahlfeldern.
  Header set Content-Security-Policy "default-src 'self'; script-src 'self' https://cdn.jsdelivr.net; style-src 'self'; font-src 'self'; img-src 'self' blob: data: https://ekaqkfgvisdngsskzbai.supabase.co; frame-src blob: https://ekaqkfgvisdngsskzbai.supabase.co; connect-src 'self' https://ekaqkfgvisdngsskzbai.supabase.co wss://ekaqkfgvisdngsskzbai.supabase.co; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript
</IfModule>
